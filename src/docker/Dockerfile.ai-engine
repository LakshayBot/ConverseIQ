FROM python:3.12-slim AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 curl git build-essential cmake libtool autoconf automake \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

COPY src/callpilot-ai-engine/pyproject.toml .
COPY src/callpilot-ai-engine/requirements-nemotron.txt .

RUN pip install --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -e .

# ── Nemotron (experimental) ──────────────────────────────────────────────
# Conditionally installs nemo_toolkit[asr] (~3 GB PyTorch + NeMo).
# Skip this layer by setting NEMOTRON_INSTALL=false at build time.
ARG NEMOTRON_INSTALL=true
RUN if [ "$NEMOTRON_INSTALL" = "true" ]; then \
      pip install --no-cache-dir -r requirements-nemotron.txt; \
    else \
      echo "Skipping Nemotron install (NEMOTRON_INSTALL=$NEMOTRON_INSTALL)"; \
    fi

COPY src/callpilot-ai-engine/engine/ ./engine/

RUN adduser --disabled-password --gecos "" appuser && chown -R appuser:appuser /app \
    && mkdir -p /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser /home/appuser/.cache
USER appuser

EXPOSE 8001

ENV WHISPER_MODEL_SIZE=medium.en
ENV WHISPER_DEVICE=cpu
ENV WHISPER_COMPUTE_TYPE=int8
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=300s \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "engine.main:app", "--host", "0.0.0.0", "--port", "8001"]
