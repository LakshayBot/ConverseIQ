root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx,vb,vbx}]
indent_size = 4

[*.{json,jsonc,xml,config,csproj,props,targets}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{css,scss,pcss}]
indent_size = 2

[*.{py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sln,slnx}]
indent_style = tab
indent_size = 2

[Makefile]
indent_style = tab
