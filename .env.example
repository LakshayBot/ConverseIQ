# CallPilot AI Environment Configuration
# Copy this file to .env and customize for your deployment

# PostgreSQL
POSTGRES_DB=callpilot
POSTGRES_USER=callpilot
POSTGRES_PASSWORD=callpilot_dev

# JWT Authentication (generate your own secret!)
JWT_SECRET=Change-This-To-A-Random-Secret-Of-At-Least-32-Characters
JWT_ISSUER=CallPilot
JWT_AUDIENCE=CallPilot
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Encryption Key (32 bytes base64 encoded)
ENCRYPTION_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=

# AI Engine
AI_ENGINE_URL=http://localhost:8001
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5001
