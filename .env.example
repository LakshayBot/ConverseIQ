# CallPilot AI Environment Configuration
# Copy this file to .env and customize for your deployment

# ── PostgreSQL ────────────────────────────────────────────────────────────
# These credentials are baked into the postgres container at first boot.
# The .NET server reads them via docker-compose env interpolation.
#
# In LOCAL DEV (docker-compose.dev.yml) the postgres port 5432 is published
# to the host, so a SQL client (psql, TablePlus, DBeaver, pgAdmin) can
# connect with these values:
#
#   Host:     localhost
#   Port:     5432
#   Database: callpilot
#   User:     callpilot
#   Password: callpilot_dev
#
# In PRODUCTION (docker compose -f docker-compose.yml up) the dev override
# is NOT loaded, so port 5432 is NOT published — the database is reachable
# only from other services on the internal docker network (the .NET server
# connects via Host=postgres).  Override these values in production with
# strong credentials sourced from your secrets manager.
POSTGRES_DB=callpilot
POSTGRES_USER=callpilot
POSTGRES_PASSWORD=callpilot_dev

# JWT Authentication (generate your own secret!)
JWT_SECRET=Change-This-To-A-Random-Secret-Of-At-Least-32-Characters
JWT_ISSUER=CallPilot
JWT_AUDIENCE=CallPilot
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Encryption Key (32 bytes base64 encoded)
ENCRYPTION_KEY=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY=

# AI Engine
AI_ENGINE_URL=http://localhost:8001
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5001

# ── Groq (LLM provider for the structured-mode enrichment pass) ──────────
# Free tier key — sign up at https://console.groq.com (no credit card
# required).  Required by the AI engine; the service raises on missing
# and the page-level fail-open wrapper converts that to "enrichment
# failed" with the original Docling chunks kept.
GROQ_API_KEY=your-groq-api-key-here
# llama-3.1-8b-instant is Groq's fast free-tier default.  Swap to
# llama-3.3-70b-versatile for higher-quality output if you have a paid
# key and the rate limit headroom.
ENRICHMENT_MODEL=llama-3.1-8b-instant
